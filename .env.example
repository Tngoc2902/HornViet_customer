# Địa chỉ backend Hồn Sừng Việt (HornViet.Api).
# Backend phải có http://localhost:3000 trong App:CorsOrigins.
NEXT_PUBLIC_API_BASE_URL=http://localhost:21021
# NEXT_PUBLIC_API_BASE_URL=https://localhost:44311

# Trang quản trị (repo HornViet_admin). Dùng cho link khi Nhân viên lỡ đăng nhập ở cửa hàng; để trống thì ẩn link.
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Đăng nhập bằng Google: OAuth Client ID (Google Cloud Console → APIs & Services → Credentials → OAuth client ID,
# loại "Web application", Authorized JavaScript origins có http://localhost:3000). Trùng Google:ClientId của backend.
# Để trống thì ẩn nút "Đăng nhập bằng Google".
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Tài khoản nhận chuyển khoản của cửa hàng — hiện mã VietQR (điền sẵn số tiền + mã đơn) khi khách chọn chuyển khoản.
# BIN ngân hàng tra ở https://api.vietqr.io/v2/banks (VD Vietcombank 970436, Techcombank 970407, MB 970422, BIDV 970418).
# Để trống thì dùng tài khoản mặc định trong lib/hsv/bank.ts (Techcombank · 0451 000 123 456 · CTY TNHH HỒN SỪNG VIỆT).
NEXT_PUBLIC_BANK_BIN=
NEXT_PUBLIC_BANK_NAME=
NEXT_PUBLIC_BANK_ACCOUNT_NO=
NEXT_PUBLIC_BANK_ACCOUNT_NAME=
